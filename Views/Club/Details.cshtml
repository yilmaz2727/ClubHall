@using OgrenciKulupSistemi.Models
@using System.Security.Claims
@using SQLitePCL
@model Club
@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = currentUserId == Model.AdminId;
}

<link rel="stylesheet" href="~/css/club.css">



<div class="cover-container-fixed">
    <img src="@Model.CoverPhotoUrl" />
</div>

<div class="club-header-fixed">
    <div class="club-info-fixed">
        <img src="@Model.LogoImageUrl" class="club-logo-fixed" />
        <div class="club-texts">
            <div class="club-name-fixed">@Model.Name</div>
        </div>
    </div>
    <div class="club-buttons">
        @if (isAdmin && !(Model.AdminId == null))
        {
            <a class="edit-btn-fixed">Edit</a>
        }
        <a class="join-btn-fixed">Katıl</a>
    </div>

</div>

<div class="menu-tabs">
    <div id="tabAbout" class="tab-item active" onclick="showTab('about')">Hakkımızda</div>
    <div id="tabEvents" class="tab-item" onclick="showTab('events')">Etkinlikler</div>
    @if (isAdmin && !(Model.AdminId == null))
    {
        <div id="tabCreateEvent" class="tab-item" onclick="showTab('createEvent')">Etkinlik Oluştur</div>
        <div id="tabMembers" class="tab-item" onclick="showTab('members')">Üyeler</div>
    }

</div>

<div id="about-section" class="content-area">
    <div class="about-section">
        <div class="about-title">Kısaca Biz</div>
        <div class="about-text">
            @Model.Description
        </div>
    </div>
</div>

<div id="events-section" class="content-area" style="display:none;">
    <div class="about-section">
        <div class="about-title">Etkinlikler</div>
        @if (Model.Events == null || !Model.Events.Any())
        {
            <p>Bu kulübe ait etkinlik bulunmamaktadır.</p>
        }
        else
        {
            <div class="event-grid">
                @foreach (var ev in Model.Events)
                {
                    <div class="event-card">
                        <img src="@ev.EventPhotoUrl" />
                        <div class="event-title">@ev.Title</div>
                        <div class="event-desc">
                            @(ev.Description?.Length > 80
                                                ? ev.Description.Substring(0, 80) + "..."
                                                : ev.Description)
                        </div>
                        <a asp-controller="Event" asp-action="Details" asp-route-id="@ev.Id" class="event-details-btn">
                            Detaylara Git
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div id="createEvent-section" class="content-area" style="display:none;">

    <h3 class="mb-3">Yeni Etkinlik Oluştur</h3>

    <form asp-action="CreateEvent" asp-controller="Club" asp-route-id="@Model.Id" method="post"
        enctype="multipart/form-data" class="p-4 shadow-sm rounded bg-white">

        @Html.AntiForgeryToken()

        <input type="hidden" name="ClubId" value="@Model.Id" />

        <div class="mb-3">
            <label class="form-label">Etkinlik Başlığı</label>
            <input type="text" name="Title" class="form-control" placeholder="Etkinlik adını yazın" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Açıklama</label>
            <textarea name="Description" class="form-control" rows="4" placeholder="Etkinlik açıklamasını giriniz"
                required></textarea>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Başlangıç Tarihi</label>
                <input type="datetime-local" name="StartDate" class="form-control" required />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Bitiş Tarihi</label>
                <input type="datetime-local" name="EndDate" class="form-control" required />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Son Başvuru Tarihi</label>
            <input type="datetime-local" name="RegistrationDeadline" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Etkinlik Türü</label>
            <select name="EventType" class="form-select" required>
                <option value="">Seçiniz</option>
                <option value="Education">Eğitim</option>
                <option value="Entertainment">Eğlence</option>
                <option value="Workshop">Workshop</option>
                <option value="Seminar">Seminer</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Konum</label>
            <input type="text" name="Location" class="form-control" placeholder="Etkinlik yeri" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Katılımcı Sayısı</label>
            <input type="number" name="NumberOfAttendance" class="form-control" min="0" />
        </div>

        <div class="mb-3">
            <label class="form-label">Etkinlik Fotoğrafı</label>
            <input type="file" name="EventPhoto" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Kaydet</button>
    </form>

</div>

<div id="members-section" class="content-area" style="display: none;">
    <ul>
        @foreach (var member in Model.Memberships)
        {
            <li>@member.ApplicationUser.FirstName @member.ApplicationUser.LastName</li>
        }
    </ul>

</div>

<script src="~/js/club.js"></script>