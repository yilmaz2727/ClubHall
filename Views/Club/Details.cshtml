@using ClubHall.Models
@model Club

<style>
    .cover-container-fixed {
        width: 100%;
        height: 260px;
        overflow: hidden;
        border-radius: 8px;
        margin-bottom: 0;
        position: relative;
        z-index: 1;
    }
    .cover-container-fixed img {
        width: 100%;
        height: 260px;
        object-fit: cover;
    }
    .club-header-fixed {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: -50px;
        padding: 0 25px;
        position: relative;
        z-index: 5;
    }
    .club-info-fixed {
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .club-logo-fixed {
        width: 110px;
        height: 110px;
        border-radius: 12px;
        border: 4px solid white;
        object-fit: cover;
        background: white;
        box-shadow: 0 3px 6px rgba(0, 0, 0, 0.15);
    }
    .club-name-fixed {
        font-size: 32px;
        font-weight: 700;
        margin-top: 50px;
    }
    .join-btn-fixed {
        padding: 10px 25px;
        background: #007bff;
        color: white;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        margin-top: 50px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }
    .menu-tabs {
        display: flex;
        gap: 30px;
        margin-top: 25px;
        border-bottom: 1px solid #ddd;
    }
    .tab-item {
        padding-bottom: 10px;
        font-size: 18px;
        font-weight: 600;
        color: #555;
        text-decoration: none;
        cursor: pointer;
    }
    .tab-item.active {
        color: #007bff;
        border-bottom: 3px solid #007bff;
    }
    .content-area {
        margin-top: 35px;
        display: flex;
        gap: 40px;
    }
    .about-section {
        flex: 3;
    }
    .about-title {
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 15px;
    }
    .about-text {
        font-size: 16px;
        color: #444;
        line-height: 1.6;
    }
    #events-section {
        display: none;
    }
    .event-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }
    .event-card {
        border: 1px solid #ddd;
        padding: 15px;
        border-radius: 8px;
        background: #fff;
        transition: 0.2s;
    }
    .event-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }
    .event-title {
        font-size: 19px;
        font-weight: 700;
        margin-bottom: 8px;
    }
    .event-desc {
        color: #555;
        font-size: 14px;
        margin-bottom: 12px;
    }
    .event-details-btn {
        display: inline-block;
        padding: 6px 15px;
        background: #007bff;
        color: white;
        border-radius: 6px;
        text-decoration: none;
        font-size: 14px;
    }
</style>

<div class="cover-container-fixed">
    <img src="@Model.CoverPhotoUrl" />
</div>

<div class="club-header-fixed">
    <div class="club-info-fixed">
        <img src="@Model.LogoImageUrl" class="club-logo-fixed" />
        <div class="club-texts">
            <div class="club-name-fixed">@Model.Name</div>
        </div>
    </div>
    <a class="join-btn-fixed">Katıl</a>
</div>

<div class="menu-tabs">
    <div id="tabAbout" class="tab-item active" onclick="showTab('about')">Hakkımızda</div>
    <div id="tabEvents" class="tab-item" onclick="showTab('events')">Etkinlikler</div>
</div>

<div id="about-section" class="content-area">
    <div class="about-section">
        <div class="about-title">Kısaca Biz</div>
        <div class="about-text">
            @Model.Description
        </div>
    </div>
</div>

<div id="events-section" class="content-area">
    <div class="about-section">
        <div class="about-title">Etkinlikler</div>
        @if (Model.Events == null || !Model.Events.Any())
        {
            <p>Bu kulübe ait etkinlik bulunmamaktadır.</p>
        }
        else
        {
            <div class="event-grid">
                @foreach (var ev in Model.Events)
                {
                    <div class="event-card">
                        <div class="event-title">@ev.Title</div>
                        <div class="event-desc">
                            @(ev.Description?.Length > 80
                                                ? ev.Description.Substring(0, 80) + "..."
                                                : ev.Description)
                        </div>
                        <a asp-controller="Event" asp-action="Details" asp-route-id="@ev.Id" class="event-details-btn">
                            Detaylara Git
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>

<script>
    function showTab(tab) {
        const about = document.getElementById("about-section");
        const events = document.getElementById("events-section");

        const tabAbout = document.getElementById("tabAbout");
        const tabEvents = document.getElementById("tabEvents");

        if (tab === "about") {
            about.style.display = "flex";
            events.style.display = "none";

            tabAbout.classList.add("active");
            tabEvents.classList.remove("active");
        }
        else {
            about.style.display = "none";
            events.style.display = "flex";

            tabEvents.classList.add("active");
            tabAbout.classList.remove("active");
        }
    }
</script>