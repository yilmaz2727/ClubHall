@using OgrenciKulupSistemi.ViewModels
@using System.Security.Claims
@using SQLitePCL
@model ClubDetailsViewModel

@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = currentUserId == Model.Club.AdminId; // isAdmin, giriş yapmış olan kullanıcının ilgili kulübün admini mi olduğunu kontrol eder.
}

<link rel="stylesheet" href="~/css/club.css">

<div class="cover-container-fixed">
    <img src="@Model.Club.CoverPhotoUrl" />
</div>

<div class="club-header-fixed">
    <div class="club-info-fixed">
        <img src="@Model.Club.LogoImageUrl" class="club-logo-fixed" />
        <div class="club-texts">
            <div class="club-name-fixed">@Model.Club.Name</div>
        </div>
    </div>
    <div class="club-buttons">
        @if (isAdmin && !(Model.Club.AdminId == null))
        {
            <button type="submit" class="edit-btn-fixed"> Edit</button>
        }

        <form asp-controller="Club" asp-action="ClubJoin" method="post">
            <input type="hidden" name="clubId" value="@Model.Club.Id" />
            <button type="submit" class="join-btn-fixed">
                Join
            </button>
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Message"]
                </div>

            }
            else if (TempData["Message2"] != null)
            {
                <div class="alert alert-primary">
                    @TempData["Message2"]
                </div>
            }
        </form>


    </div>

</div>

<div class="menu-tabs">
    <div id="tabAbout" class="tab-item active" onclick="showTab('about')">Hakkımızda</div>
    <div id="tabEvents" class="tab-item" onclick="showTab('events')">Etkinlikler</div>
    @if (isAdmin && !(Model.Club.AdminId == null))
    {
        <div id="tabCreateEvent" class="tab-item" onclick="showTab('createEvent')">Etkinlik Oluştur</div>
        <div id="tabMembers" class="tab-item" onclick="showTab('members')">Üyeler</div>
    }

</div>

<div id="about-section" class="content-area">
    <div class="about-section">
        <div class="about-title">Kısaca Biz</div>
        <div class="about-text">
            @Model.Club.Description
            @foreach (var photo in Model.Club.Photos) {
                <img src="@photo.ImageUrl" alt="Club Photo" />
            }                
        </div>
    </div>
</div>

<div id="events-section" class="content-area" style="display:none;">
    <div class="about-section">
        <div class="about-title">Etkinlikler</div> @* kulübe ait bütün etkinlikler listelenecek *@
        @if (Model.Club.Events == null || !Model.Club.Events.Any())
        {
            <p>Bu kulübe ait etkinlik bulunmamaktadır.</p>
        }
        else
        {
            <div class="event-grid">
                @foreach (var ev in Model.Club.Events)
                {
                    <div class="event-card">
                        <img src="@ev.EventPhotoUrl" />
                        <div class="event-title">@ev.Title</div>
                        <div class="event-desc">
                            @(ev.Description?.Length > 80
                                                ? ev.Description.Substring(0, 80) + "..."
                                                : ev.Description)
                        </div>
                        <a asp-controller="Event" asp-action="Details" asp-route-id="@ev.Id" class="event-details-btn">
                            Detaylara Git
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div id="createEvent-section" class="content-area" style="display:none;">

    <h3 class="mb-3">Yeni Etkinlik Oluştur</h3>

    <form asp-action="CreateEvent" asp-controller="Club" asp-route-id="@Model.Club.Id" method="post"
        enctype="multipart/form-data" class="p-4 shadow-sm rounded bg-white">

        @Html.AntiForgeryToken()

        <input type="hidden" name="ClubId" value="@Model.Club.Id" />

        <div class="mb-3">
            <label class="form-label">Etkinlik Başlığı</label>
            <input type="text" asp-for="@Model.Event.Title" class="form-control" placeholder="Etkinlik adını yazın" required />
            <span asp-validation-for="@Model.Event.Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Açıklama</label>
            <textarea asp-for="@Model.Event.Description" class="form-control" rows="4" placeholder="Etkinlik açıklamasını giriniz" required></textarea>
            <span asp-validation-for="@Model.Event.Description" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Başlangıç Tarihi</label>
                <input type="datetime-local" asp-for="@Model.Event.StartDate" class="form-control" required />
                <span asp-validation-for="@Model.Event.StartDate" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Bitiş Tarihi</label>
                <input type="datetime-local" asp-for="@Model.Event.EndDate" class="form-control" required />
                <span asp-validation-for="@Model.Event.EndDate" class="text-danger"></span>
            </div>

        </div>

        <div class="mb-3">
            <label class="form-label">Son Başvuru Tarihi</label>
            <input type="datetime-local" asp-for="@Model.Event.RegistrationDeadline" class="form-control" required />
            <span asp-validation-for="@Model.Event.RegistrationDeadline" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Etkinlik Türü</label>
            <select asp-for="@Model.Event.EventType" class="form-select" required>
                <option value="">Seçiniz</option>
                <option value="Education">Eğitim</option>
                <option value="Entertainment">Eğlence</option>
                <option value="Workshop">Workshop</option>
                <option value="Seminar">Seminer</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Konum</label>
            <input type="text" asp-for="@Model.Event.Location" class="form-control" placeholder="Etkinlik yeri" required />
            <span asp-validation-for="@Model.Event.Location" class="text-danger"></span>
        </div>

        @* <div class="mb-3">
            <label class="form-label">Katılımcı Sayısı</label>
            <input type="number" name="NumberOfAttendance" class="form-control" min="0" />
        </div> *@

        <div class="mb-3">
            <label class="form-label">Etkinlik Fotoğrafı</label>
            <input type="file" asp-for="@Model.Event.EventPhotoUrl"" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Kaydet</button>
    </form>

</div>

<div id="members-section" class="content-area" style="display: none;">
    <ul>
        @foreach (var member in Model.Club.Memberships)
        {
            <li>@member.ApplicationUser.FirstName @member.ApplicationUser.LastName</li>
        }
    </ul>

</div>

<script src="~/js/club.js"></script>