@using OgrenciKulupSistemi.ViewModels
@using System.Security.Claims
@using SQLitePCL
@model ClubDetailsViewModel

@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = currentUserId == Model.Club.AdminId; // isAdmin, giriş yapmış olan kullanıcının ilgili kulübün admini miolduğunu kontrol eder.
}

<link rel="stylesheet" href="~/css/club.css">

<div class="cover-container-fixed">
    <img src="@Model.Club.CoverPhotoUrl" />
</div>

<div class="club-header-fixed">
    <div class="club-info-fixed">
        <img src="@Model.Club.LogoImageUrl" class="club-logo-fixed" />
        <div class="club-texts">
            <div class="club-name-fixed">@Model.Club.Name</div>
        </div>
    </div>
    <div class="club-buttons">
        @if (isAdmin && !(Model.Club.AdminId == null))
        {
            <a asp-controller="Club" asp-action="Edit" asp-route-id="@Model.Club.Id" class="edit-btn-fixed">Edit</a>
        }
        @if (!isAdmin)
        {
            <form asp-controller="Club" asp-action="ClubJoin" method="post">
                <input type="hidden" name="clubId" value="@Model.Club.Id" />
                <button type="submit" class="join-btn-fixed">
                    Join
                </button>
                @if (TempData["alreadyJoined"] != null)
                {
                    <script> document.addEventListener("DOMContentLoaded", function () {
                            showJoinToast("@TempData[key: "alreadyJoined"]", "#F76C6C");
                        }); </script>
                }
                else if (TempData["Success"] != null)
                {
                    <script> document.addEventListener("DOMContentLoaded", function () {
                            showJoinToast("@TempData["Success"]", "#048023");
                        }); </script>
                }
            </form>

        }
    </div>

</div>

<div class="menu-tabs">
    <div id="tabAbout" class="tab-item active" onclick="showTab('about')">About</div>
    <div id="tabEvents" class="tab-item" onclick="showTab('events')">Events</div>
    @if (isAdmin && !(Model.Club.AdminId == null))
    {
        <div id="tabCreateEvent" class="tab-item" onclick="showTab('createEvent')">Create an Event</div>
        <div id="tabMembers" class="tab-item" onclick="showTab('members')">Members</div>
    }

</div>

<div id="about-section" class="content-area">
    <div class="about-section">
        <div class="about-title">About Us</div>
        <div class="about-text">
            @Model.Club.Description
            @if (Model.Club.Photos != null && Model.Club.Photos.Any())
            {
                <div class="photo-gallery">
                    @foreach (var photo in Model.Club.Photos)
                    {
                        <img src="@photo.ImageUrl" alt="Club Photo" />
                    }
                </div>
            }
        </div>
    </div>
</div>

<div id="events-section" class="content-area" style="display:none;">
    <div class="about-section">
        <div class="about-title">Events</div> @* kulübe ait bütün etkinlikler listelenecek *@
        @if (Model.Club.Events == null || !Model.Club.Events.Any())
        {
            <div class="no-event-card text-center">
                <div class="no-event-icon mb-3">📅</div>
                <h5>No events yet</h5>
                <p class="text-muted">
                    This club hasn’t created any events yet.<br />
                    Stay tuned or check back later.
                </p>
            </div>

        }
        else
        {
            <div class="event-grid">
                @foreach (var ev in Model.Club.Events)
                {
                    <div class="event-card">
                        <img class="card-img-top" src="@ev.EventPhotoUrl" />
                        <div class="event-title">@ev.Title</div>
                        <div class="event-desc">
                            @(ev.Description?.Length > 80
                                                ? ev.Description.Substring(0, 80) + "..."
                                                : ev.Description)
                        </div>
                        <a asp-controller="Event" asp-action="Details" asp-route-id="@ev.Id" class="event-details-btn">
                            Details
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div id="createEvent-section" class="content-area" style="display:none;">

    <h3 class="mb-3">
    @(ViewBag.EditMode == true ? "Edit Event" : "Create an Event")
    </h3>

    <form asp-action="@(ViewBag.EditMode == true ? "EditEvent" : "CreateEvent")"
      asp-controller="Club"
      asp-route-id="@Model.Club.Id"
      method="post"
      enctype="multipart/form-data" class="p-4 shadow-sm rounded bg-white">

        @Html.AntiForgeryToken()

        @if (ViewBag.EditMode == true)
        {
            <input type="hidden" name="Id" value="@Model.Event.Id" />
        }

        <div class="mb-3">
            <label class="form-label">Title</label>
            <input type="text" asp-for="@Model.Event.Title" class="form-control" placeholder="Type the event name"
                required />
            <span asp-validation-for="@Model.Event.Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="@Model.Event.Description" class="form-control" rows="4"
                placeholder="Enter the event description." required></textarea>
            <span asp-validation-for="@Model.Event.Description" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Start Date</label>
                <input type="datetime-local" asp-for="@Model.Event.StartDate" class="form-control" required />
                <span asp-validation-for="@Model.Event.StartDate" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">End Date</label>
                <input type="datetime-local" asp-for="@Model.Event.EndDate" class="form-control" required />
                <span asp-validation-for="@Model.Event.EndDate" class="text-danger"></span>
            </div>

        </div>

        <div class="mb-3">
            <label class="form-label">Deadline</label>
            <input type="datetime-local" asp-for="@Model.Event.RegistrationDeadline" class="form-control" required />
            <span asp-validation-for="@Model.Event.RegistrationDeadline" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Event Type</label>
            <select asp-for="@Model.Event.EventType" class="form-select" required>
                <option value="">Choose</option>
                <option value="Education">Education</option>
                <option value="Entertainment">Entertainment</option>
                <option value="Workshop">Workshop</option>
                <option value="Seminar">Seminar</option>
            </select>
            <span asp-validation-for="@Model.Event.EventType" class="text-danger"></span>

        </div>

        <div class="mb-3">
            <label class="form-label">Location</label>
            <input type="text" asp-for="@Model.Event.Location" class="form-control" placeholder="Place of event"
                required />
            <span asp-validation-for="@Model.Event.Location" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Event Photo</label>
            <input type="file" name="EventPhoto" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
    </form>

</div>

<div id="members-section" class="content-area" style="display: none;">

    <table class="table mt-3">
        <thead>
            <tr>
                <th>Member</th>
                <th>Number of Events</th>
                <th>Participation Date</th>
                @if (isAdmin)
                {
                    <th class="text-end">Actions</th>
                }
            </tr>
        </thead>

        <tbody>
            @foreach (var member in Model.Club.Memberships)
            {
                var eventCount = Model.Club.Events
                .Count(e => e.Attendees.Any(a => a.ApplicationUserId == member.ApplicationUserId));

                <tr>
                    <td>
                        <img src="https://ui-avatars.com/api/?name=@member.ApplicationUser.FirstName+@member.ApplicationUser.LastName"
                            class="rounded-circle me-2" width="35" />
                        @member.ApplicationUser.FirstName @member.ApplicationUser.LastName
                    </td>

                    <td>@eventCount</td>

                    <td>@member.JoinDate.ToString("dd.MM.yyyy")</td>

                    @if (isAdmin)
                    {
                        <td class="text-end">
                            @* Admin kendini silemesin *@
                            @if (member.ApplicationUserId != Model.Club.AdminId)
                            {
                                <form asp-action="RemoveMember" asp-controller="Club" method="post" class="d-inline">
                                    <input type="hidden" name="membershipId" value="@member.Id" />
                                    <input type="hidden" name="clubId" value="@Model.Club.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Bu üyeyi kulüpten çıkarmak istediğine emin misin?');">
                                        Remove
                                    </button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

</div>


<script src="~/js/club.js"></script>