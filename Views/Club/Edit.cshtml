@model OgrenciKulupSistemi.ViewModels.ClubEditViewModel

<h2>Edit Club</h2>

<form id="editClubForm" asp-controller="Club" asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <!-- Hataları kullanıcıya göster -->
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Logo</label>
        @if (!string.IsNullOrEmpty(Model.ExistingLogoImageUrl))
        {
            <div class="mb-2">
                <img src="@Model.ExistingLogoImageUrl" style="max-height:80px;" />
            </div>
        }
        <input asp-for="LogoImage" type="file" class="form-control" accept="image/*" />
    </div>

    <div class="mb-3">
        <label class="form-label">Cover Photo</label>
        @if (!string.IsNullOrEmpty(Model.ExistingCoverPhotoUrl))
        {
            <div class="mb-2">
                <img src="@Model.ExistingCoverPhotoUrl" style="max-height:120px;" />
            </div>
        }
        <input asp-for="CoverPhoto" type="file" class="form-control" accept="image/*" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}