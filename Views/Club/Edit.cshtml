@model OgrenciKulupSistemi.ViewModels.ClubEditViewModel

<h2>Edit Club</h2>

               @*asp-action="Edit": ClubController Edit (POST)                enctype="multipart/form-data": Required for logo & cover photo upload*@
<form id="editClubForm" asp-controller="Club" asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()    @*Protection against CSRF (Cross-Site Request Forgery) attacks*@

    <input type="hidden" asp-for="Id" />  @*The ID of the club hosting the event (sent to the controller via POST)*@

    @*Show the errors to the user.*@
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Logo</label>
        @if (!string.IsNullOrEmpty(Model.ExistingLogoImageUrl))  @*Show the user a preview of the existing logo if one is available.*@
        {
            <div class="mb-2">
                <img src="@Model.ExistingLogoImageUrl" style="max-height:80px;" />
            </div>
        }
        @*If the new logo is selected, the old logo will be updated on the controller side.*@
        <input asp-for="LogoImage" type="file" class="form-control" accept="image/*" />
    </div>

    <div class="mb-3">
        <label class="form-label">Cover Photo</label>
        @if (!string.IsNullOrEmpty(Model.ExistingCoverPhotoUrl))  @*Current cover photo preview*@
        {
            <div class="mb-2">
                <img src="@Model.ExistingCoverPhotoUrl" style="max-height:120px;" />
            </div>
        }
        <input asp-for="CoverPhoto" type="file" class="form-control" accept="image/*" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button> @*The form is submitted, and the Edit POST action is executed.*@
</form>


@section Scripts {
    @*Client-side validation (jquery validation) *@
    <partial name="_ValidationScriptsPartial" />
}