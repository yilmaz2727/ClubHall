@using OgrenciKulupSistemi.Models
@using System.Security.Claims
@using System.Linq
@model List<Club>
@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isUserAdmin = Model.Any(c=>c.AdminId==currentUserId);
}

<div class="text-center">
    <div class="row">
        @foreach (var club in Model)
        {
            <div class="col-lg-4 col-md-6 col-sm-12 mb-4 d-flex align-items-stretch">
                @await Html.PartialAsync("_ClubCard", club)
            </div>
        }



        @if (User.Identity.IsAuthenticated && !isUserAdmin) {
            <a class="btn btn-primary" asp-action="Create" asp-controller="Club">Create Club</a>
        }

    </div>
</div>