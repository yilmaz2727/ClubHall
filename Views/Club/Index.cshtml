@using OgrenciKulupSistemi.Models
@using System.Security.Claims
@using System.Linq
@model List<Club>
@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isUserAdmin = Model.Any(c=>c.AdminId==currentUserId);
}

<div class="text-center">
    <div class="row">
        @foreach (var club in Model)
        {
            @await Html.PartialAsync("_ClubCard", club)
        }



        @if (User.Identity.IsAuthenticated && !isUserAdmin) {
            <a class="btn btn-primary" asp-action="Create" asp-controller="Club">Create Club</a> @* bunun tasarımını ve konumunu değiştirmeliyiz *@
        }

    </div>
</div>