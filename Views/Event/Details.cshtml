@using System.Security.Claims
@using Microsoft.CodeAnalysis.CSharp.Syntax
@model Event
@using System.Security.Claims

@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = currentUserId == Model.Club.AdminId;
}

<div class="card mb-4">
    <div class="card-header">
    </div>

    <div class="card-body d-flex justify-content-between align-items-center">

        <div>
            <h5 class="card-title mb-1">@Model.Title</h5>
            <p class="card-text mb-0">@Model.StartDate</p>
        </div>
        <!--////////////////////////////////////////////////////////////////////-->


        <div class="d-flex align-items-center gap-2">

            <form asp-controller="Event" asp-action="Join" method="post">
                <input type="hidden" name="eventId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary">
                    Join
                </button>
                @if (TempData["alreadyJoined"] != null)
                {
                    <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            showJoinToast("@TempData[key: "alreadyJoined"]", "#F76C6C"); // soft red
                        });
                    </script>
                }

                @if (TempData["Success"] != null)
                {
                    <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            showJoinToast("@TempData["Success"]", "#048023");
                        });
                    </script>
                }

            </form>

            @* yeni eklendi!! etkinlik silme --> sadece kulübün admini silebiilir.  *@
            @if (isAdmin)
            {
                <form asp-action="RemoveEvent" asp-controller="Club" method="post">
                    <input type="hidden" name="eventId" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger"
                        onclick="return confirm('Are you sure you want to delete this event?! ')"> Delete </button>
                </form>
            }

            @* yeni eklendi!! etkinlik editleme --> sadece kulübün admini editleyebilir.  *@
            @if (isAdmin)
            {
                <a asp-controller="Club"
                   asp-action="Details"
                   asp-route-id="@Model.ClubId"
                   asp-route-tab="createEvent"
                   asp-route-editEventId="@Model.Id"
                   asp-route-tab="createEvent"
                   class="btn btn-warning">
                    Edit
                </a>
            }

        </div>
        <!--////////////////////////////////////////////////////////////////////-->
        

    </div>
</div>

<div class="container">
    <div class="row">

        <div class="col-md-7">
            <div class="card mb-3">
                <img class="card-img-top" src="@Model.EventPhotoUrl" alt="Event image">
                <div class="card-body">
                    <h5 class="card-title">@Model.Title</h5>
                    <p class="card-text">@Model.Description</p>
                    <p class="card-text"><small class="text-muted">@Model.StartDate</small></p>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <h4 class="mb-3">Detail</h4>
            <div class="card mb-3">

                <ul class="list-group list-group-flush">
                    
                    <li class="list-group-item detail-item">
                        <div class="icon-box">
                            <i class="bi bi-building"></i>
                        </div>
                        <div class="content-stack">
                            <span class="detail-title">ORGANIZING CLUB</span>
                            <span class="detail-data">@Model.Club.Name</span>

                            <a asp-controller="Club"
                               asp-action="Details"
                               asp-route-id="@Model.ClubId"
                               class="btn btn-outline-primary btn-sm mt-2">
                                Go to Club Page
                            </a>
                        </div>
                    </li>


                    <li class="list-group-item detail-item">
                        <div class="icon-box">
                            <i class="bi bi-calendar"></i>
                        </div>
                        <div class="content-stack">
                            <span class="detail-title">EVENT START</span>
                            <span class="detail-data">@Model.StartDate</span>
                        </div>
                    </li>

                    <li class="list-group-item detail-item">
                        <div class="icon-box">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                        <div class="content-stack">
                            <span class="detail-title">EVENT FINISH</span>
                            <span class="detail-data">@Model.EndDate</span>
                        </div>
                    </li>

                    <li class="list-group-item detail-item">
                        <div class="icon-box">
                            <i class="bi bi-chat-dots"></i>
                        </div>
                        <div class="content-stack">
                            <span class="detail-title">EVENT TYPE</span>
                            <span class="detail-data">@Model.EventType</span>
                        </div>
                    </li>

                    <li class="list-group-item detail-item">
                        <div class="icon-box">
                            <i class="bi bi-people"></i>
                        </div>
                        <div class="content-stack">
                            <span class="detail-title">NUMBER OF PARTICIPANTS</span>
                            <span class="detail-data">@Model.NumberOfAttendance</span>
                        </div>
                    </li>

                    <li class="list-group-item detail-item">
                        <div class="icon-box">
                            <i class="bi bi-clock"></i>
                        </div>
                        <div class="content-stack">
                            <span class="detail-title">FINAL APPLICATION DATE</span>
                            <span class="detail-data">@Model.RegistrationDeadline</span>
                        </div>
                    </li>

                </ul>
            </div>
        </div>

    </div>
</div>