@model ApplicationUser

<div class="container mt-4">
    <div class="row">

        <!-- SOL PROFİL KARTI -->
        <div class="col-lg-3 mb-4">
            <div class="profile-sidebar-card">
                <div class="profile-sidebar-header text-center">
                    <div class="profile-avatar-circle mx-auto mb-2">
                        
                    </div>
                    @if (Model != null)
                    {

                        <div>@Model.FirstName @Model.LastName</div>
                    }
                    else
                    {

                        <div> <a asp-action="Login" asp-controller="Login">Login </a> </div>
                    }
                    <a asp-controller="Profile" asp-action="Index" class="small text-muted">
                        See Profile
                    </a>
                </div>
            </div>
        </div>