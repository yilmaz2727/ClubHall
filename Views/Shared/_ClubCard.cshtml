@model OgrenciKulupSistemi.Models.Club



<div class="col-md-4 mb-3 d-flex">
    <div class="card border-0 shadow-sm rounded-3 transition-card flex-fill" style="width: 100%;">
        @* <img class="card-img-top" src="@Model.LogoImageUrl" alt="Card image cap"> Buraya ClubPhoto gelecek*@
        <div class="card-body">
            <h5 class="card-title">@Model.Name</h5>
            <p class="card-text">@Model.Description</p>
            <a asp-controller="Club" asp-action="Details" asp-route-id="@Model.Id" class="stretched-link"></a>
        </div>
    </div>
</div>