@using Microsoft.AspNetCore.Identity
@model ApplicationUser



  


<div class="container my-5">
    <div class="profile-card shadow-sm mx-auto">

        <!-- Üst mavi alan -->
        <div class="profile-cover"></div>

        <!-- Profil avatarı -->
        <div class="profile-avatar">
            <div class="avatar-circle d-flex align-items-center justify-content-center">
            </div>
        </div>

        <!-- Alt beyaz içerik + Ayar ikonunun doğru yeri -->
        <div class="profile-body d-flex align-items-center justify-content-between">

            <!-- Sol taraf: Kullanıcı adı -->
            <div>
                <div class="profile-name">@Model.FirstName @Model.LastName</div>
                <div class="profile-location">Maltepe, İstanbul</div>
            </div>

            <!-- Sağ taraf: Ayar Butonu -->
            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="settings-icon">
                <i class="bi bi-gear"></i>
            </a>

        </div>

    </div>
</div>



<div>
    <a asp-action="MyEvents" asp-controller=profile"" class="">Etkinlikelrim</a> <!-- ileride kullanıcı kulüplere kayıt olabildiğinde bu kısımları güncelleyeceğiz. şuanlık burada yapılacak bir şey yok. -->
</div>

<div>
    <a asp-action="MyMemberships" asp-controller="profile" class="">Üyeliklerim</a>
</div>


